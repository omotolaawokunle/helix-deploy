APP_NAME=HelixDeploy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
VERIFICATION_URL_ROOT=https://your-domain.example

SPA_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=helixdeploy
DB_USERNAME=helixdeploy
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=your-domain.example

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=helixdeploy
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host/port/scheme the *browser* uses (often your HTTPS domain on 443).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Internal address for API/worker event publishing (Docker Compose service: reverb:8080)
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Baked into the frontend image at build time (must match what browsers use).
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=${REVERB_PORT}
VITE_REVERB_SCHEME=${REVERB_SCHEME}

# Host publish for the frontend container (loopback + high port behind host Nginx/TLS).
FRONTEND_PUBLISH_BIND=127.0.0.1
FRONTEND_PUBLISH_PORT=8085

RELEASE_RETENTION=5
DEPLOYMENT_TIMEOUT=30
BUILD_TIMEOUT=30
SSH_TIMEOUT=30
PING_INTERVAL=5
STUCK_THRESHOLD=35

OBSERVABILITY_PROJECT=helixdeploy
OBSERVABILITY_METRICS_ENABLED=true
# Comma-separated IPs allowed to scrape /metrics (add Prometheus host, Docker gateway, etc.)
OBSERVABILITY_METRICS_ALLOWED_IPS=127.0.0.1
OBSERVABILITY_LOKI_ENABLED=true
OBSERVABILITY_REDIS_DB=5
# Use http://loki:3100 when API containers join the observability Docker network (observability_net).
# Use http://host.docker.internal:3100 only if Loki is bound on the host (not 127.0.0.1-only).
LOKI_URL=http://loki:3100
